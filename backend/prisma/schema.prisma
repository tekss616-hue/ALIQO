generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  PRIMARY_ADMIN
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ChatType {
  DIRECT
  GROUP
  MATCH
  ROOM
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  VOICE
  FILE
  SYSTEM
}

enum MatchMode {
  ONE_V_ONE
  GROUP
}

enum MatchQueueStatus {
  WAITING
  MATCHED
  CANCELLED
  EXPIRED
}

enum MatchSessionStatus {
  ACTIVE
  FINISHED
  CANCELLED
}

enum RoomVisibility {
  PUBLIC
  PRIVATE
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum MediaUploadStatus {
  PENDING
  UPLOADED
  ATTACHED
  EXPIRED
  REJECTED
}

model User {
  id                String               @id @default(cuid())
  email             String               @unique
  username          String               @unique
  passwordHash      String
  role              UserRole             @default(USER)
  isActive          Boolean              @default(true)
  deletedAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  profile           Profile?
  refreshTokens     RefreshToken[]
  sentRequests      Friendship[]         @relation("FriendshipRequester")
  receivedRequests  Friendship[]         @relation("FriendshipAddressee")
  blocksCreated     BlockedUser[]        @relation("Blocker")
  blocksReceived    BlockedUser[]        @relation("Blocked")
  chatMemberships   ChatMember[]
  messages          Message[]            @relation("MessageSender")
  messageReactions  MessageReaction[]
  notifications     Notification[]
  matchQueueEntries MatchQueueEntry[]
  matchPlayers      MatchSessionPlayer[]
  roomsCreated      SocialRoom[]         @relation("RoomCreator")
  roomMembers       RoomMember[]
  deviceTokens      DeviceToken[]
  mediaUploads      MediaUpload[]

  @@index([username])
  @@index([email])
}

model Profile {
  id          String    @id @default(cuid())
  userId      String    @unique
  displayName String
  avatarUrl   String?
  bio         String?   @db.VarChar(280)
  isOnline    Boolean   @default(false)
  lastSeenAt  DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model BlockedUser {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Chat {
  id           String        @id @default(cuid())
  type         ChatType
  title        String?
  avatarUrl    String?
  createdById  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  members      ChatMember[]
  messages     Message[]
  matchSession MatchSession?
  socialRoom   SocialRoom?
  mediaUploads MediaUpload[]

  @@index([updatedAt])
}

model ChatMember {
  id            String   @id @default(cuid())
  chatId        String
  userId        String
  isAdmin       Boolean  @default(false)
  joinedAt      DateTime @default(now())
  lastReadAt    DateTime?
  lastReadMsgId String?
  muted         Boolean  @default(false)
  chat          Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId, chatId])
}

model Message {
  id          String            @id @default(cuid())
  chatId      String
  senderId    String
  type        MessageType       @default(TEXT)
  text        String?           @db.VarChar(4000)
  mediaUrl    String?
  mediaName   String?
  mediaMime   String?
  mediaSize   Int?
  replyToId   String?
  isEdited    Boolean           @default(false)
  editedAt    DateTime?
  deletedAt   DateTime?
  pinnedAt    DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  chat        Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender      User              @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo     Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     Message[]         @relation("MessageReplies")
  reactions   MessageReaction[]

  @@index([chatId, createdAt])
  @@index([senderId, createdAt])
  @@index([replyToId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String   @db.VarChar(32)
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    @db.VarChar(64)
  title     String    @db.VarChar(160)
  body      String?   @db.VarChar(500)
  dataJson  String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model DeviceToken {
  id         String         @id @default(cuid())
  userId     String
  platform   DevicePlatform @default(ANDROID)
  tokenHash  String         @unique
  tokenValue String         @db.VarChar(4096)
  appVersion String?        @db.VarChar(40)
  lastSeenAt DateTime       @default(now())
  revokedAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([lastSeenAt])
}

model MediaUpload {
  id          String            @id @default(cuid())
  userId      String
  chatId      String
  status      MediaUploadStatus @default(PENDING)
  objectKey   String            @unique
  fileName    String            @db.VarChar(240)
  mimeType    String            @db.VarChar(120)
  byteSize    Int
  sha256      String?           @db.VarChar(64)
  publicUrl   String?           @db.VarChar(1200)
  expiresAt   DateTime
  uploadedAt  DateTime?
  attachedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat        Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([chatId, status, createdAt])
  @@index([expiresAt])
}

model MatchQueueEntry {
  id        String           @id @default(cuid())
  userId    String
  mode      MatchMode
  status    MatchQueueStatus @default(WAITING)
  sessionId String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mode, status, createdAt])
  @@index([userId, status])
}

model MatchSession {
  id         String                 @id @default(cuid())
  mode       MatchMode
  status     MatchSessionStatus     @default(ACTIVE)
  chatId     String                 @unique
  minPlayers Int
  maxPlayers Int
  startedAt  DateTime               @default(now())
  endedAt    DateTime?
  chat       Chat                   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  players    MatchSessionPlayer[]
}

model MatchSessionPlayer {
  id        String       @id @default(cuid())
  sessionId String
  userId    String
  joinedAt  DateTime     @default(now())
  session   MatchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
}

model SocialRoom {
  id          String         @id @default(cuid())
  name        String         @db.VarChar(80)
  description String?        @db.VarChar(280)
  visibility  RoomVisibility @default(PUBLIC)
  capacity    Int            @default(50)
  isActive    Boolean        @default(true)
  creatorId   String
  chatId      String         @unique
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  creator     User           @relation("RoomCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  chat        Chat           @relation(fields: [chatId], references: [id], onDelete: Cascade)
  members     RoomMember[]

  @@index([visibility, isActive, updatedAt])
}

model RoomMember {
  id       String     @id @default(cuid())
  roomId   String
  userId   String
  joinedAt DateTime   @default(now())
  room     SocialRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}
