DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aliqo?schema=public"
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
JWT_REFRESH_SECRET="replace-with-at-least-32-random-characters"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PRIMARY_ADMIN_EMAIL="lbtkwnalasr@gmail.com"
AI_API_KEY=

# Media storage. Keep credentials only in deployment secrets.
# Recommended no-card setup for ALIQO testing: ImageKit Free.
MEDIA_PROVIDER=imagekit
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Optional Cloudinary configuration kept for portability.
MEDIA_CLOUDINARY_CLOUD_NAME=
MEDIA_CLOUDINARY_API_KEY=
MEDIA_CLOUDINARY_API_SECRET=

# Alternative Cloudflare R2 configuration.
MEDIA_BASE_URL=
MEDIA_R2_ENDPOINT=
MEDIA_R2_BUCKET=
MEDIA_R2_ACCESS_KEY_ID=
MEDIA_R2_SECRET_ACCESS_KEY=

# Optional external signing provider kept for portability.
MEDIA_SIGNING_ENDPOINT=
MEDIA_ACCESS_KEY=
MEDIA_SECRET_KEY=

# Push provider. Keep service credentials out of source control.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

PORT=3000
